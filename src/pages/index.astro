  <!-- FOOTER -->
  <footer>
    <div class="footer-inner">
      <div class="footer-logo">
        <div class="footer-logo-box font-display">JP</div>
        <span class="footer-copy"
          >© 2025 Joachim Hanz N. Pastor. Built with <span>Astro</span> + <span
            >Three.js</span
          >
        </span>
      </div>
      <div class="footer-links">
        <a href="#about" class="footer-link">about</a>
        <a href="#stack" class="footer-link">stack</a>
        <a href="#projects" class="footer-link">projects</a>
        <a href="#contact" class="footer-link">contact</a>
      </div>
    </div>
  </footer>
</Layout>

<script>
  // ===== NAVBAR SCROLL =====
  const navbar = document.getElementById("navbar");
  if (navbar) {
    window.addEventListener("scroll", () => {
      navbar.classList.toggle("scrolled", window.scrollY > 40);
    });
  }

  // ===== SCROLL REVEAL =====
  const reveals = document.querySelectorAll(".reveal");
  const ro = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("visible");
        }
      });
    },
    { threshold: 0.1 },
  );
  reveals.forEach((r) => ro.observe(r));

  // ===== PROJECT IMAGE UPLOADER INTERACTIVE LISTENERS =====
  document.querySelectorAll(".proj-img-input").forEach((inputEl) => {
    inputEl.addEventListener("change", (e) => {
      const target = e.target as HTMLInputElement;
      const file = target.files?.[0];
      if (!file) return;

      const reader = new FileReader();
      const imgId = target.getAttribute("data-img-target");

      reader.onload = (evt) => {
        if (!imgId || !evt.target?.result) return;
        const img = document.getElementById(imgId) as HTMLImageElement;
        if (img) {
          img.src = evt.target.result as string;
          img.classList.add("loaded");

          const zone = target.closest(".proj-img-zone");
          const placeholder = zone?.querySelector(
            ".proj-img-placeholder",
          ) as HTMLElement;
          if (placeholder) {
            placeholder.style.display = "none";
          }
        }
      };
      reader.readAsDataURL(file);
    });
  });

  // Clicking on project image zone triggers file selection
  document.querySelectorAll(".proj-img-zone").forEach((zone) => {
    zone.addEventListener("click", (e) => {
      // Don't double trigger if clicking directly on the input
      if (e.target instanceof HTMLInputElement) return;
      const input = zone.querySelector(".proj-img-input") as HTMLInputElement;
      input?.click();
    });
  });
</script>
