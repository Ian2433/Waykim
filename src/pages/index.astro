---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import { Cursor } from "../components/Cursor";
import { HeroCanvas } from "../components/HeroCanvas";
import { SkillsProgress } from "../components/SkillsProgress";
import { CertificatesCarousel } from "../components/CertificatesCarousel";
import { CertCanvas } from "../components/CertCanvas";
import { ContactForm } from "../components/ContactForm";
import { ContactCanvas } from "../components/ContactCanvas";
import pastorImg from "../assets/pastor.jpg";
import hrdujaliImg from "../assets/hrdujali.png";
import kucoopImg from "../assets/kucoop.png";
---

<Layout>
  <!-- Interactive Cursor -->
  <Cursor client:only="react" />

  <!-- NAVBAR -->
  <header id="navbar">
    <div class="nav-inner">
      <a href="#hero" class="logo">
        <div class="logo-box">W</div>
        <div class="logo-text">Way<span>kim</span></div>
      </a>
      <nav class="nav-links">
        <a href="#about" class="nav-link">About</a>
        <a href="#stack" class="nav-link">Tech Stack</a>
        <a href="#projects" class="nav-link">Projects</a>
        <a href="#education" class="nav-link">Education</a>
        <a href="#certificates" class="nav-link">Certificates</a>
        <a href="#contact" class="nav-link">Contact</a>
      </nav>
      <a href="#contact" class="nav-cta">Hire Me →</a>
    </div>
  </header>

  <!-- HERO -->
  <section id="hero">
    <!-- Interactive ThreeJS Canvas -->
    <HeroCanvas client:only="react" />

    <div class="hero-grid"></div>
    <div class="hero-inner">
      <div>
        <div class="available-badge">
          <span class="available-dot"></span>
          <span class="available-text">Available for Work</span>
        </div>
        <h1 class="hero-heading font-display">
          Hi, I'm<br />
          <span class="text-gradient">Joachim Hanz N. Pastor</span><br />
          <span class="muted">Developer.</span>
        </h1>
        <p class="hero-sub">
          Transforming Vision Into Reality Through Technology. BSIT student at
          Davao del Norte State College, passionate about software development
          and building innovative systems that solve real-world problems.
        </p>
        <div class="hero-btns">
          <a href="#projects" class="btn-primary">View My Work →</a>
        </div>
        <div class="hero-stats">
          <a href="#projects" class="stat-item">
            <div class="stat-num font-display">2</div>
            <div class="stat-label">PROJECTS</div>
          </a>
          <div class="stat-item no-link">
            <div class="stat-num font-display">3+</div>
            <div class="stat-label">YEARS CODING</div>
          </div>
          <a href="#certificates" class="stat-item">
            <div class="stat-num font-display">3</div>
            <div class="stat-label">CERTIFICATES</div>
          </a>
        </div>
      </div>
      <div class="hero-visual">
        <div class="avatar-wrap">
          <div class="avatar-circle">
            <Image
              src={pastorImg}
              alt="Joachim Hanz N. Pastor"
              width={280}
              height={280}
              style="width:100%;height:100%;object-fit:cover;"
            />
          </div>
          <div class="orbit-ring"></div>
        </div>
      </div>
    </div>
    <div class="scroll-hint">
      <span class="scroll-label">SCROLL</span>
      <div class="scroll-line"></div>
    </div>
  </section>

  <!-- ABOUT -->
  <section id="about">
    <div class="about-blob"></div>
    <div class="section-inner">
      <div class="two-col">
        <div class="about-card reveal">
          <div class="card-shadow-1"></div>
          <div class="card-shadow-2"></div>
          <div class="card-main">
            <div class="profile-row">
              <div
                class="profile-icon font-display"
                style="overflow:hidden;padding:0;"
              >
                <Image
                  src={pastorImg}
                  alt="Joachim Hanz N. Pastor"
                  width={64}
                  height={64}
                  style="width:100%;height:100%;object-fit:cover;"
                />
              </div>
              <div>
                <div class="profile-name font-display">
                  Joachim Hanz N. Pastor
                </div>
                <div class="profile-role">
                  BSIT Student · Software Developer
                </div>
              </div>
            </div>
            <p class="profile-quote">
              "Building practical systems with clean code and modern engineering
              standards."
            </p>
            <div class="mini-stats">
              <div class="mini-stat">
                <div class="mini-stat-num font-display">2</div><div
                  class="mini-stat-label"
                >
                  Projects
                </div>
              </div>
              <div class="mini-stat">
                <div class="mini-stat-num font-display">3</div><div
                  class="mini-stat-label"
                >
                  Certs
                </div>
              </div>
              <div class="mini-stat">
                <div class="mini-stat-num font-display">2025</div><div
                  class="mini-stat-label"
                >
                  Graduating
                </div>
              </div>
            </div>
            <div class="tags">
              <span class="pill">Backend Logic</span>
              <span class="pill">Frontend Dev</span>
              <span class="pill">DB Design</span>
              <span class="pill">Mobile Apps</span>
              <span class="pill">System Architecture</span>
            </div>
          </div>
        </div>
        <div class="about-text">
          <div class="section-tag reveal">About Me</div>
          <h2 class="section-heading font-display reveal reveal-delay-1">
            Turning ideas into<br /><span class="text-gradient"
              >digital reality</span
            >
          </h2>
          <div class="about-paras reveal reveal-delay-2">
            <p>
              I’m Joachim Hanz N. Pastor, a graduating BSIT student from Davao
              del Norte State College with a strong focus on software
              development and system architecture. I’m driven by curiosity and
              solid engineering principles, specializing in backend logic, clean
              and responsive frontend development, database design, and building
              modern, user-centered systems.
            </p>
            <p>
              I work with technologies such as JavaScript, React, and Tailwind
              CSS to develop efficient and scalable web applications. I also use
              Figma and Canva for UI/UX design to create clean, intuitive, and
              visually consistent interfaces.
            </p>
          </div>
          <div class="qualities-grid reveal reveal-delay-3">
            <div class="quality">
              <span class="quality-icon">⚡</span><span class="quality-label"
                >Performance-first</span
              >
            </div>
            <div class="quality">
              <span class="quality-icon">🎨</span><span class="quality-label"
                >Design-minded</span
              >
            </div>
            <div class="quality">
              <span class="quality-icon">🧱</span><span class="quality-label"
                >System Architecture</span
              >
            </div>
            <div class="quality">
              <span class="quality-icon">🤝</span><span class="quality-label"
                >Team player</span
              >
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- TECH STACK -->
  <section id="stack">
    <div class="stack-glow-l"></div>
    <div class="stack-glow-r"></div>
    <div class="marquee-wrap">
      <div class="marquee">
        <span class="marquee-item">React</span><span class="marquee-item"
          >Astro</span
        ><span class="marquee-item">TypeScript</span><span class="marquee-item"
          >Flutter</span
        ><span class="marquee-item">FastAPI</span><span class="marquee-item"
          >PostgreSQL</span
        ><span class="marquee-item">Firebase</span><span class="marquee-item"
          >Python</span
        ><span class="marquee-item">Three.js</span><span class="marquee-item"
          >Tailwind CSS</span
        ><span class="marquee-item">Node.js</span><span class="marquee-item"
          >MySQL</span
        >
        <span class="marquee-item">React</span><span class="marquee-item"
          >Astro</span
        ><span class="marquee-item">TypeScript</span><span class="marquee-item"
          >Flutter</span
        ><span class="marquee-item">FastAPI</span><span class="marquee-item"
          >PostgreSQL</span
        ><span class="marquee-item">Firebase</span><span class="marquee-item"
          >Python</span
        ><span class="marquee-item">Three.js</span><span class="marquee-item"
          >Tailwind CSS</span
        ><span class="marquee-item">Node.js</span><span class="marquee-item"
          >MySQL</span
        >
      </div>
    </div>
    <div class="section-inner">
      <div class="stack-center">
        <div class="stack-section-tag reveal">Tech Stack</div>
        <h2 class="stack-heading font-display reveal reveal-delay-1">
          Tools I work<br /><span>with daily</span>
        </h2>
      </div>

      <!-- Interactive React Skills Progress component -->
      <SkillsProgress client:load />
    </div>
  </section>

  <!-- PROJECTS -->
  <section id="projects">
    <div class="section-inner">
      <div class="projects-header">
        <div>
          <div class="section-tag reveal">Projects</div>
          <h2
            class="section-heading font-display reveal reveal-delay-1"
            style="margin-top:24px"
          >
            Things I've<br /><span class="text-gradient">built & shipped</span>
          </h2>
        </div>
      </div>

      <div
        class="projects-featured"
        style="grid-template-columns:repeat(2,1fr)"
      >
        <!-- Project 1: HRDOCS -->
        <div class="proj-card reveal reveal-delay-1">
          <div
            class="proj-top-bar"
            style="background:linear-gradient(to right,#c084fc,#a855f7)"
          >
          </div>
          <div class="proj-img-zone" style="cursor:default;">
            <Image
              src={hrdujaliImg}
              alt="HRDOCS - HRMIS for Municipality of Braulio E. Dujali"
              width={600}
              height={340}
              style="width:100%;height:100%;object-fit:cover;"
              class="loaded"
            />
          </div>
          <div class="proj-body">
            <div class="proj-head-row">
              <span class="proj-num font-display">01</span>
              <div class="proj-actions">
                <a
                  href="https://hrdujali.online/"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="proj-btn-link">→</a
                >
              </div>
            </div>
            <div class="proj-title font-display">HRDOCS — HRMIS</div>
            <div class="proj-desc">
              A web-based Human Resource Management Information System (HRMIS)
              developed for the Municipality of Braulio E. Dujali. Automates
              employee record management, attendance tracking, service records,
              and document generation.
            </div>
            <div class="proj-tags">
              <span class="pill">Web App</span><span class="pill">HRMIS</span
              ><span class="pill">PHP</span><span class="pill">MySQL</span>
            </div>
          </div>
        </div>

        <!-- Project 2: KUCoop -->
        <div class="proj-card reveal reveal-delay-2">
          <div
            class="proj-top-bar"
            style="background:linear-gradient(to right,#a855f7,#7c3aed)"
          >
          </div>
          <div class="proj-img-zone" style="cursor:default;">
            <Image
              src={kucoopImg}
              alt="KUCoop - Cooperative Management System"
              width={600}
              height={340}
              style="width:100%;height:100%;object-fit:cover;"
              class="loaded"
            />
          </div>
          <div class="proj-body">
            <div class="proj-head-row">
              <span class="proj-num font-display">02</span>
              <div class="proj-actions">
                <a
                  href="http://kucoop.online/"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="proj-btn-link">→</a
                >
              </div>
            </div>
            <div class="proj-title font-display">
              KUCoop — Cooperative Management
            </div>
            <div class="proj-desc">
              A web-based Cooperative Management System developed for
              KusinaUniversity Online Tutorial Services (KUOTS) to address
              challenges in managing cooperative operations through manual
              processes.
            </div>
            <div class="proj-tags">
              <span class="pill">Web App</span><span class="pill"
                >Cooperative</span
              ><span class="pill">PHP</span><span class="pill">MySQL</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- EDUCATION -->
  <section id="education">
    <div class="edu-top-line"></div>
    <div class="section-inner">
      <div class="stack-center">
        <div class="section-tag reveal">Education</div>
        <h2
          class="section-heading font-display reveal reveal-delay-1"
          style="margin-top:24px"
        >
          Educational<br /><span class="text-gradient">background</span>
        </h2>
      </div>
      <div class="edu-grid" style="grid-template-columns:1fr 1fr">
        <!-- Education 1 -->
        <div class="edu-card reveal reveal-delay-1">
          <div class="edu-head">
            <div class="edu-icon">🎓</div>
            <div>
              <div class="edu-degree font-display">
                Bachelor of Science in Information Technology
              </div>
              <div class="edu-school">Davao del Norte State College</div>
              <div class="edu-meta">
                <span class="pill">2022 – Present</span>
                <div class="edu-gpa">
                  <span class="edu-gpa-label">Status</span><span
                    class="edu-gpa-val">Graduating</span
                  >
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Education 2 -->
        <div class="edu-card reveal reveal-delay-2">
          <div class="edu-head">
            <div class="edu-icon">📚</div>
            <div>
              <div class="edu-degree font-display">
                Humanities and Social Sciences
              </div>
              <div class="edu-school">Panabo City Senior High School</div>
              <div class="edu-meta">
                <span class="pill">2020 – 2022</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Education 3 -->
        <div class="edu-card reveal reveal-delay-3">
          <div class="edu-head">
            <div class="edu-icon">🖥️</div>
            <div>
              <div class="edu-degree font-display">Junior High School</div>
              <div class="edu-school">Panabo City National High School</div>
              <div class="edu-meta">
                <span class="pill">2016 – 2020</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Education 4 -->
        <div class="edu-card reveal reveal-delay-4">
          <div class="edu-head">
            <div class="edu-icon">🏫</div>
            <div>
              <div class="edu-degree font-display">
                Primary Elementary Education
              </div>
              <div class="edu-school">Rizal Elementary School</div>
              <div class="edu-meta">
                <span class="pill">2011 – 2016</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CERTIFICATES -->
  <section id="certificates">
    <!-- Three.js Starfield Canvas behind Certificates -->
    <CertCanvas client:only="react" />

    <!-- React Cards Deck Swiper component -->
    <CertificatesCarousel client:load />
  </section>

  <!-- CONTACT -->
  <section id="contact">
    <!-- Interactive ThreeJS canvas background -->
    <ContactCanvas client:only="react" />

    <div class="contact-glow"></div>
    <div class="contact-inner">
      <div class="contact-section-tag reveal">Contact</div>
      <h2 class="contact-heading font-display reveal reveal-delay-1">
        Let's build something<br /><span>great together</span>
      </h2>
      <p class="contact-sub reveal reveal-delay-2">
        I'm currently open to freelance projects, full-time roles, and exciting
        collaborations. Drop me a line — I always reply within 24 hours.
      </p>

      <!-- Interactive React Form -->
      <ContactForm client:load />

      <div class="socials-row reveal reveal-delay-4">
        <span class="socials-label">FIND ME ON</span>
        <a
          href="https://github.com/wakimhanz"
          target="_blank"
          rel="noopener noreferrer"
          class="social-btn"
          aria-label="GitHub"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
